# ===========================================================================
# ner_translate pipeline image — extends the shared base image (deploy/
# Dockerfile) with ONLY this pipeline's own dependencies. See
# docs/MODEL_CONTAINER_ISOLATION.md (Option A) for why this exists: a shared
# image + shared requirements.txt let one pipeline's deps silently change a
# version every other model relied on.
#
# Build order (base must exist first — build it via the root Dockerfile the
# same way the shared cluster does; then the wheelhouse; then this image):
#   docker build -t multi-model-inference:latest -f deploy/Dockerfile .
#   bash deploy/scripts/build_ner_translate_wheelhouse.sh
#   docker build -t ner-translate-worker:latest -f deploy/Dockerfile.ner_translate .
#
# Run this pipeline's own small cluster (separate from the shared cluster):
#   docker compose -f deploy/docker-compose.ner_translate.yml up
#
# Runtime dependency hotfix (rare — see wheels-hotfix/ner_translate/README.md):
# deploy/apply_wheels_hotfix.sh runs at container start and installs anything
# dropped in the /wheels-hotfix mount, on top of what's baked in below.
# ===========================================================================
FROM multi-model-inference:latest

# Tesseract OCR + poppler (PDF rasterization) — required by extract_text()'s
# PDF/image paths in models/pipelines/ner_translate/mt_ner_all_formats.py.
# Language packs match that file's OCR_LANG constant exactly — extend both
# together if you add a language.
RUN apt-get update && apt-get install -y --no-install-recommends \
        tesseract-ocr tesseract-ocr-mar tesseract-ocr-hin tesseract-ocr-tel \
        tesseract-ocr-tam tesseract-ocr-kan tesseract-ocr-ben tesseract-ocr-guj \
        tesseract-ocr-pan tesseract-ocr-mal tesseract-ocr-urd \
        poppler-utils && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# This pipeline's own deps only — never add anything here that belongs in
# the shared requirements.txt instead.
#
# Installed from the LOCAL wheelhouse (deploy/scripts/build_ner_translate_wheelhouse.sh
# output), not the live index — --no-index makes the build fail loudly if
# the wheelhouse is missing/stale, rather than silently resolving a
# different version than whatever was tested (this bit us once already —
# see docs/CHANGELOG_20260913.md, Dockerfile.worker's nightly torch pin
# that no longer existed by the time it was rebuilt).
COPY wheels/ner_translate/ /tmp/wheels/
COPY models/pipelines/ner_translate/requirements.txt /tmp/ner_translate_requirements.txt
RUN pip install --no-cache-dir --no-index --find-links=/tmp/wheels -r /tmp/ner_translate_requirements.txt && \
    rm -rf /tmp/wheels

# Dependency hotfix mechanism — no-op unless /wheels-hotfix has content at
# container start. See deploy/apply_wheels_hotfix.sh's own header comment
# for what this is (and isn't) for.
COPY deploy/apply_wheels_hotfix.sh /usr/local/bin/apply_wheels_hotfix.sh
RUN chmod +x /usr/local/bin/apply_wheels_hotfix.sh
